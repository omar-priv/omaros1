# Sadim OS — نواة مينية لاختبار الإقلاع في QEMU (المرحلة 2)
# تُدمج فوق tinyconfig عبر scripts/kconfig/merge_config.sh
# الهدف: إقلاع من bzImage + initramfs عبر -kernel (بدون سائق قرص) ووصول init
# إلى علامة SADIM-BOOT-OK عبر منفذ تسلسلي.

CONFIG_LOCALVERSION="-sadim-phase4"
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# الإقلاع من initramfs وتنفيذ /init (سكربت shebang)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# أنظمة ملفات افتراضية يحتاجها init
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# أساسيات userland
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_UNIX=y

# تشخيص أفضل عند الأعطال
CONFIG_KALLSYMS=y

# --- v0.2: إضافات العتاد الحقيقي + ISO Live (اختبار على الجهاز لاحقاً — لا ادعاء دعم قبل ذلك) ---

# PCI مطلوب لكل تعريفات العتاد الحقيقية (كان معطلاً في tinyconfig)
CONFIG_PCI=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ACPI=y

# العرض: i915 + fbcon للجهاز الحقيقي، VGA text لQEMU/الأنظمة القديمة
CONFIG_VGA_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_SUPPORT=y

# لوحة المفاتيح/اللمس المدمجة عبر i8042 (المسار القياسي للحاسبات المحمولة)
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y

# أجهزة USB (كيبورد/ماوس خارجي، لاحقاً USB معتمد للإقلاع)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# شبكة أساسية + إيثرنت Realtek (10EC:8168 → r8169) — بلا تعريفات تلقائية خارجة عن المصدر
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_R8169=y

# بنية تحميل الثوابت (جاهزة للمراحل القادمة: Wi-Fi/صوت)
CONFIG_FW_LOADER=y

# أدوات التشخيص
CONFIG_MAGIC_SYSRQ=y
CONFIG_UNIX98_PTYS=y

# --- v0.3: الجذر الحي (Buildroot squashfs عبر overlayfs) + virtio (مسار بوابة CI) ---
CONFIG_BLOCK=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# --- v0.3b: وسائط live الحقيقية — قراءة CD (ATA/ATAPI) وفلاشة USB من النواة نفسها ---
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# --- v0.4: واجهة رسومية — virtio-gpu للاختبار في QEMU، i915 للجهاز الحقيقي ---
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_RENDER=y
# simpledrm ليس في 6.12 — fbdev emulation يغطي الإطار الأساسي

# --- v0.5: العتاد الحقيقي (مرحلة 6) — Acer E5-576G ---
# Wi-Fi Qualcomm Atheros QCA9377 (168C:0042) — ath10k + firmware-5.bin
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH10K_DEBUG=y
CONFIG_ATH10K_TRACING=y
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_FW_LOADER_USER_HELPER=y

# الصوت Realtek HD Audio + Intel Display Audio
CONFIG_SND=y
CONFIG_SND_CORE=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_HDA_CORE=y

# الطاقة والبطارية (صحة البطارية ≈60% — مراقبة فعلية)
CONFIG_ACPI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_ADAPTER=y
CONFIG_ACPI_THERMAL=y
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_FAIR_SHARE=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_BATTERY=y
CONFIG_BATTERY_BQ27xxx=y
CONFIG_POWER_SUPPLY=y
CONFIG_HWMON=y
CONFIG_HWMON_VID=y

# USB 2.0 (فلاشة USB 2.0 للإقلاع والتخزين)
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UAS=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ASIX=y
CONFIG_USB_NET_DRIVERS=y

# لمس اللوحة (Synaptics/Elantech/i8042)
CONFIG_INPUT=y
CONFIG_INPUT_POLLDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_BYD=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_LIFEBOOK=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_TOUCHSCREEN_SYNAPTICS=y
CONFIG_TOUCHSCREEN_ELANTECH=y

# أنظمة ملفات — دعم القراءة من أقسام Windows (NTFS/FAT) بدون تعديل
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# تخزين الكتل SMR — تحسينات للكتابة المتسلسلة
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_NULL_BLK=y
CONFIG_BLK_DEV_RAM=y
CONFIG_CRC32=y
CONFIG_CRC32_SLICEBY8=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4HC_COMPRESS=y
CONFIG_XZ_DEC=y
CONFIG_ZSTD_DECOMPRESS=y

# التشفير والأمان (للمراقبة والتحقق من الحزم)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MANAGER=y

# مُراقبة الموارد (مرحلة 7)
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_NET=y
CONFIG_INET=y

# end v0.5

