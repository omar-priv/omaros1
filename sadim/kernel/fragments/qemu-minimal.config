# Sadim OS — نواة مينية لاختبار الإقلاع في QEMU (المرحلة 2)
# تُدمج فوق tinyconfig عبر scripts/kconfig/merge_config.sh
# الهدف: إقلاع من bzImage + initramfs عبر -kernel (بدون سائق قرص) ووصول init
# إلى علامة SADIM-BOOT-OK عبر منفذ تسلسلي.

CONFIG_LOCALVERSION="-sadim-phase2"
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# الإقلاع من initramfs وتنفيذ /init (سكربت shebang)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# أنظمة ملفات افتراضية يحتاجها init
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# أساسيات userland
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_UNIX=y

# تشخيص أفضل عند الأعطال
CONFIG_KALLSYMS=y
