# Sadim OS x86_64 kernel fragment for Legacy BIOS Live ISO and QEMU smoke tests.
CONFIG_LOCALVERSION="-sadim-phase6"
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_UNIX=y
CONFIG_KALLSYMS=y
CONFIG_PCI=y
# tinyconfig disables this menu despite its Kconfig default; enable it explicitly.
# VIRTIO_PCI selects the hidden VIRTIO core; Acer-specific drivers remain enabled.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ACPI=y

# Intel HD 620 display path
CONFIG_VGA_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FB=y

# Keyboard, touchpad and USB controllers/storage
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y

# Read-only Live medium and internal filesystems
CONFIG_BLOCK=y
CONFIG_OVERLAY_FS=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Acer hardware: Ethernet, QCA9377 Wi-Fi, Realtek HDA, ACPI power/thermal
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_R8169=y
CONFIG_FW_LOADER=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_CORE=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_HDA_CORE=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_ADAPTER=y
CONFIG_ACPI_THERMAL=y
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_POWER_SUPPLY=y
CONFIG_HWMON=y
CONFIG_HWMON_VID=y

# Built-in RAM swap; no HDD-backed swap and no module-loading assumption.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y

CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_UNIX98_PTYS=y
