# Sadim OS — نواة مينية لاختبار الإقلاع في QEMU (المرحلة 2)
# تُدمج فوق tinyconfig عبر scripts/kconfig/merge_config.sh
# الهدف: إقلاع من bzImage + initramfs عبر -kernel (بدون سائق قرص) ووصول init
# إلى علامة SADIM-BOOT-OK عبر منفذ تسلسلي.

CONFIG_LOCALVERSION="-sadim-phase2"
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# الإقلاع من initramfs وتنفيذ /init (سكربت shebang)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# أنظمة ملفات افتراضية يحتاجها init
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# أساسيات userland
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_UNIX=y

# تشخيص أفضل عند الأعطال
CONFIG_KALLSYMS=y

# --- v0.2: إضافات العتاد الحقيقي + ISO Live (اختبار على الجهاز لاحقاً — لا ادعاء دعم قبل ذلك) ---

# PCI مطلوب لكل تعريفات العتاد الحقيقية (كان معطلاً في tinyconfig)
CONFIG_PCI=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ACPI=y

# العرض: i915 + fbcon للجهاز الحقيقي، VGA text لQEMU/الأنظمة القديمة
CONFIG_VGA_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONT_SUPPORT=y

# لوحة المفاتيح/اللمس المدمجة عبر i8042 (المسار القياسي للحاسبات المحمولة)
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y

# أجهزة USB (كيبورد/ماوس خارجي، لاحقاً USB معتمد للإقلاع)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# شبكة أساسية + إيثرنت Realtek (10EC:8168 → r8169) — بلا تعريفات تلقائية خارجة عن المصدر
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_R8169=y

# بنية تحميل الثوابت (جاهزة للمراحل القادمة: Wi-Fi/صوت)
CONFIG_FW_LOADER=y

# أدوات التشخيص
CONFIG_MAGIC_SYSRQ=y
CONFIG_UNIX98_PTYS=y

# --- v0.3: الجذر الحي (Buildroot squashfs عبر overlayfs) + virtio (مسار بوابة CI) ---
CONFIG_BLOCK=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

