# Sadim OS — تكوين Buildroot LTS 2025.02.19 (المرحلة 5: Qt6 + تطبيقات)
# القالب: build.sh يستبدل @OVERLAY@ بمسار طبقة سديم الفعلي قبل defconfig
# مساحة المستخدم: musl + busybox (init سديم عبر طبقتنا) — C++ مفعّل لمتطلبات Qt6/Weston

# معمارية x86_64 عامة (Acer E5-576G i5-7200U)
BR2_x86_64=y

# سلسلة أدوات داخلية musl (+C++ للمراحل الرسومية)
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# متطلبات weston/qt6: dynamic libs، threads، headers >= 3.0، locale
BR2_ENABLE_LOCALE=y
BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_0=y
# !BR2_STATIC_LIBS هو الافتراضي مع musl dynamic

# init: busybox init — inittab سديم يأتي من طبقتنا (نفس مصدر initramfs)
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y

# طبقة سديم فوق الجذر: /etc سديم (passwd/group/inittab/rcS/init.d…) + bin/autologin
BR2_ROOTFS_OVERLAY="@OVERLAY@"

# الحزم الأساسية للمرحلة 3
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_KMOD=y

# --- المرحلة 4: واجهة رسومية (Wayland/weston + عربية RTL) ---
# إدارة الأجهزة: eudev (يوفر BR2_PACKAGE_HAS_UDEV المطلوب لـ weston)
BR2_PACKAGE_EUDEV=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Wayland core
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y

# Weston — compositor مرجعي لـ Wayland
# backend DRM افتراضي، renderer pixman (بلا EGL/GLES/GBM)
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_WESTON_SHELL_DESKTOP=y
# simple clients للاختبار (weston-simple-* مثل damage, dmabuf, egl)
BR2_PACKAGE_WESTON_SIMPLE_CLIENTS=y

# اعتماديات weston (تُسحب تلقائياً عبر select، لكن نثبتها صراحة للوضوح):
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBDISPLAY_INFO=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y

# دعم النصوص العربية RTL: FreeType + HarfBuzz + FriBiDi
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_FRIBIDI=y
BR2_PACKAGE_FONTCONFIG=y

# pixman renderer (مطلوب لـ cairo بدون GL) — يُسحب عبر cairo
BR2_PACKAGE_PIXMAN=y

# --- المرحلة 5: Qt6base (linuxfb backend، بلا OpenGL/EGL) ---
# Qt6 core + GUI + widgets + network + SQL + XML + test
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_SQL=y
BR2_PACKAGE_QT6BASE_SQLITE=y
BR2_PACKAGE_QT6BASE_XML=y
BR2_PACKAGE_QT6BASE_TEST=y
# linuxfb backend (يعمل على framebuffer مباشرة — بلا X11/EGL)
BR2_PACKAGE_QT6BASE_LINUXFB=y
# لا OpenGL، لا XCB، لا EGLFS
# BR2_PACKAGE_QT6BASE_OPENGL is not set
# BR2_PACKAGE_QT6BASE_XCB is not set
# BR2_PACKAGE_QT6BASE_EGLFS is not set
# دعم الخطوط العربية عبر fontconfig + harfbuzz (النظام)
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
# دعم الصور
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_JPEG=y
# منصة افتراضية: linuxfb
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="linuxfb"

# الإخراج: squashfs (يُدمج live عبر overlayfs)
BR2_TARGET_ROOTFS_SQUASHFS=y

# هوية مضيف متفقة مع طبقتنا
BR2_TARGET_GENERIC_HOSTNAME="sadim"

# --- المرحلة 6: تعريفات العتاد الحقيقي (Acer E5-576G) ---
# Wi-Fi firmware: QCA9377 ath10k — firmware-5.bin (أفضل أداءً من firmware-6)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_QCA_ATH10K=y
# أداة إدارة Wi-Fi خفيفة
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_IP=y
BR2_PACKAGE_IFCONFIG=y
BR2_PACKAGE_ETHTOOL=y

# الصوت: ALSA + أدوات التحكم
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y

# الطاقة والبطارية: acpi، acpid، مراقبة الطاقة
BR2_PACKAGE_ACPI=y
BR2_PACKAGE_ACPID=y
BR2_PACKAGE_PM_UTILS=y
BR2_PACKAGE_UPPOWER=y

# USB 2.0 أدوات التخزين
BR2_PACKAGE_USBMOUNT=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_E2FSPROGS=y

# التermostat / إدارة درجة الحرارة
BR2_PACKAGE_LM_SENSORS=y

# --- المرحلة 7: الأداء والأمان (تحسين SMR، مراقبة، مراقبة تلقائية) ---
# zRAM لضغط الذاكرة في RAM بدلاً من الكتابة على الهارد SMR
BR2_PACKAGE_ZRAM=y
# أدوات監� المراقبة الخفيفة
BR2_PACKAGE_VMSTAT=y
BR2_PACKAGE_IOSTAT=y
BR2_PACKAGE_MPSTAT=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_PROCPS=y
BR2_PACKAGE_PS=y
BR2_PACKAGE_FREE=y
BR2_PACKAGE_DF=y
BR2_PACKAGE_DU=y

# SSH للوصول عن بعد (اختياري، للأمان والتطوير)
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_SERVER=y

# محرر نصوص خفيف
BR2_PACKAGE_NANO=y

# التحقق من الحزم والتوقيعات (الأمان)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_GNUPG=y

# أدوات إدارة الحزم الأساسية (خفيفة)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# نظام ملفات مؤقت في RAM للتقليل من الكتابة على SMR
BR2_PACKAGE_TMPFS=y

# مراقب تلقائي للأداء (سكريبتات سديم)
BR2_TARGET_ROOTFS_OVERLAY="@OVERLAY@"

# sicherung: مستخدم عادي (لا root افتراضياً للاستخدام اليومي)
BR2_TARGET_GENERIC_USERS=y
BR2_TARGET_GENERIC_USER_SADIM=y
BR2_TARGET_GENERIC_USER_SADIM_HOME="/home/sadim"
BR2_TARGET_GENERIC_USER_SADIM_SHELL="/bin/sh"
BR2_TARGET_GENERIC_USER_SADIM_GROUPS="users seat audio video"

# end phase 6+7