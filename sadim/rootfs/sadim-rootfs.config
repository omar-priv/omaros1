# Sadim OS — Buildroot 2025.02.19 (lean x86_64 Live base)
# Native custom apps, Pango/Arabic shaping, Chromium, Brave and Wine are deferred.
# This lean profile provides Weston, font primitives and essential hardware tools.
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_12=y
BR2_ENABLE_LOCALE=y
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_OVERLAY="@OVERLAY@"

# Cache compiler outputs between identical GitHub Actions builds.
BR2_CCACHE=y
BR2_CCACHE_USE_BASEDIR=y

# Base system
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_GNUPG=y

# DRM / Wayland / Weston compositor
BR2_PACKAGE_EUDEV=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_WESTON_SHELL_DESKTOP=y
BR2_PACKAGE_WESTON_SIMPLE_CLIENTS=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBDISPLAY_INFO=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_PIXMAN=y

# Live filesystem
BR2_TARGET_ROOTFS_SQUASHFS=y

# Hardware support and QCA9377 firmware; real hardware remains unverified
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_NET_TOOLS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_USBMOUNT=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_LM_SENSORS=y
BR2_PACKAGE_ACPID=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_PROCPS_NG=y
