# Sadim OS — تكوين Buildroot LTS 2025.02.19 (المرحلة 3)
# القالب: build.sh يستبدل @OVERLAY@ بمسار طبقة سديم الفعلي قبل defconfig
# مساحة المستخدم: musl + busybox (init سديم عبر طبقتنا) — C++ مفعّل مسبقاً لمتطلبات المرحلة 4/5

# معمارية x86_64 عامة (Acer E5-576G i5-7200U)
BR2_x86_64=y

# سلسلة أدوات داخلية musl (+C++ للمراحل الرسومية القادمة)
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# init: busybox init — inittab سديم يأتي من طبقتنا (نفس مصدر initramfs)
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y

# طبقة سديم فوق الجذر: /etc سديم (passwd/group/inittab/rcS/init.d…) + bin/autologin
BR2_ROOTFS_OVERLAY="@OVERLAY@"

# الحزم الأساسية للمرحلة 3 (كل إضافة لاحقة تمر عبر بوابة CI أولاً)
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_KMOD=y

# الإخراج: squashfs (يُدمج live عبر overlayfs — يدعم النواة XZ+ZLIB معاً)
BR2_TARGET_ROOTFS_SQUASHFS=y

# هوية مضيف متفقة مع طبقتنا
BR2_TARGET_GENERIC_HOSTNAME="sadim"
