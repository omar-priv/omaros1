#!/bin/sh
# Sadim OS — init v0.1 (المرحلة 2)
# الهدف المعلن: إثبات وصول النظام إلى init دون Kernel Panic، عبر وسم SADIM-BOOT-OK.
# هذا أول init للمشروع — سيتبدل تدريجياً في المرحلة 3 (rootfs وخدمات).
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc 2>/dev/null    || echo "[init] WARN: proc mount failed"
mount -t sysfs sysfs /sys 2>/dev/null   || echo "[init] WARN: sysfs mount failed"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || echo "[init] WARN: devtmpfs mount failed"

echo ""
echo "=================================================="
echo "   Sadim OS (سديم) — boot v0.1"
echo "=================================================="
echo "kernel : $(uname -r)"
echo "uptime : $(cut -d ' ' -f1 /proc/uptime) s"
if [ -r /proc/meminfo ]; then
  echo "mem    : $(grep '^MemTotal:' /proc/meminfo)"
fi
echo "cpus   : $(nproc 2>/dev/null || echo 1)"
echo ""
echo "SADIM-BOOT-OK"
echo ""

# في CI: إعادة تشغيل نظيفة تُنهي QEMU (-no-reboot) بعد تسجيل الوسم
sleep 1
reboot -f
