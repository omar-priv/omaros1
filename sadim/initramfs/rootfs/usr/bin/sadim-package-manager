#!/bin/sh
# Sadim OS — Package Manager (مدير حزم بسيط)
# إدارة التطبيقات والحزم في نظام سديم OS
# لا أدوات خارجية — الأوامر اليدوية فقط

set -e

PKG_DIR="/opt/sadim-packages"
INSTALLED_FLAG="/var/lib/sadim-packages-installed"
REPO_URL="https://github.com/omar-priv/omaros1/releases/latest/download/"

log() { echo "[pkg-mgr] $*"; }

# عرض المساعدة
show_help() {
  echo "Sadim OS Package Manager — مدير الحزم البسيط"
  echo ""
  echo "الاستخدام: sadim-package-manager <أمر> [حزمة]"
  echo ""
  echo "الأوامر:"
  echo "  list      — عرض الحزم المثبتة"
  echo "  install   — تثبيت حزمة"
  echo "  remove    — إزالة حزمة"
  echo "  update    — تحديث جميع الحزم"
  echo "  search    — البحث في الحزم المتاحة"
  echo "  info      — معلومات حول حزمة"
  echo "  help      — عرض هذه المساعدة"
  echo ""
  echo "أمثلة:"
  echo "  sadim-package-manager list"
  echo "  sadim-package-manager install sadim-extra-apps"
  echo ""
  echo "⚠️  تحذير: تثبيت حزم من مصادر غير موثوقة قد يشكل خطراً أمنياً"
}

# عرض الحزم المثبتة
list_packages() {
  echo "الحزم المثبتة في نظام سديم OS:"
  echo "================================"
  if [ -f "$INSTALLED_FLAG" ]; then
    cat "$INSTALLED_FLAG" 2>/dev/null || echo "لا يمكن قراءة قائمة الحزم"
  else
    echo "لا توجد حزم مثبتة إضافية (فقط التطبيقات الأساسية)"
  fi
  echo ""
  echo "التطبيقات الأساسية (مضمنة في النظام):"
  echo "  sadim-file-explorer   — مستكشف الملفات"
  echo "  sadim-notepad         — المفكرة"
  echo "  sadim-calculator      — الحاسبة"
  echo "  sadim-task-manager    — مدير المهام"
  echo "  sadim-settings        — الإعدادات"
  echo "  sadim-terminal        — محطة الأوامر"
  echo "  sadim-browser         — متصفح الويب"
  echo "  sadim-taskbar         — شريط المهام"
  echo "  sadim-start-menu      — قائمة ابدأ"
}

# تثبيت حزمة
install_package() {
  local pkg_name="$1"
  if [ -z "$pkg_name" ]; then
    log "ERROR: يجب تحديد اسم الحزمة"
    show_help
    exit 1
  fi

  log "بدء تثبيت الحزمة: $pkg_name"

  # التحقق من الأدوات المطلوبة
  if ! command -v wget >/dev/null 2>&1; then
    log "ERROR: wget غير مثبت"
    return 1
  fi

  # التحقق من أن الحزمة غير مثبتة مسبقاً
  if [ -f "$INSTALLED_FLAG" ] && grep -qx "$pkg_name" "$INSTALLED_FLAG" 2>/dev/null; then
    log "الحزمة $pkg_name مثبتة مسبقاً"
    return 0
  fi

  # تحميل الحزمة
  local pkg_url="${REPO_URL}${pkg_name}.tar.gz"
  log "تحميل من: $pkg_url"
  if ! wget -q -O "/tmp/${pkg_name}.tar.gz" "$pkg_url" 2>/dev/null; then
    log "ERROR: تعذر تحميل الحزمة $pkg_name"
    log "قد لا تكون الحزمة متاحة في المستودع"
    return 1
  fi

  # استخراج الحزمة
  mkdir -p "$PKG_DIR"
  if ! tar xzf "/tmp/${pkg_name}.tar.gz" -C "$PKG_DIR" 2>/dev/null; then
    log "ERROR: تعذر استخراج الحزمة $pkg_name"
    rm -f "/tmp/${pkg_name}.tar.gz"
    return 1
  fi

  # تسجيل الحزمة كمثبتة
  echo "$pkg_name" >> "$INSTALLED_FLAG"
  rm -f "/tmp/${pkg_name}.tar.gz"

  log "تم تثبيت الحزمة: $pkg_name بنجاح"
}

# إزالة حزمة
remove_package() {
  local pkg_name="$1"
  if [ -z "$pkg_name" ]; then
    log "ERROR: يجب تحديد اسم الحزمة"
    show_help
    exit 1
  fi

  log "إزالة الحزمة: $pkg_name"

  # إزالة من قائمة المثبتات
  if [ -f "$INSTALLED_FLAG" ]; then
    sed -i "/^${pkg_name}$/d" "$INSTALLED_FLAG" 2>/dev/null || true
  fi

  # إزالة ملفات الحزمة
  rm -rf "$PKG_DIR/$pkg_name" 2>/dev/null || true

  log "تم إزالة الحزمة: $pkg_name"
}

# تحديث جميع الحزم
update_packages() {
  log "التحقق من التحديثات المتاحة…"
  # في هذا الإصدار، التحديثات تتم عبر إعادة بناء النظام ونشر إصدار جديد
  log "تحديث الحزم يتم عبر إصدار جديد من نظام سديم OS"
  log "للتحديث: نزّل أحدث إصدار من GitHub Releases وأعد الإقلاع"
}

# البحث في الحزم
search_packages() {
  local query="$1"
  echo "البحث في الحزم المتاحة: $query"
  echo "================================"
  echo "حزم متاحة في مستودع سديم OS:"
  echo "  sadim-extra-apps    — تطبيقات إضافية"
  echo "  sadim-dev-tools     — أدوات التطوير"
  echo "  sadim-media-codecs  — ترميزات الوسائط"
  echo ""
  echo "للInstall: sadim-package-manager install <اسم الحزمة>"
}

# معلومات حول حزمة
package_info() {
  local pkg_name="$1"
  if [ -z "$pkg_name" ]; then
    log "ERROR: يجب تحديد اسم الحزمة"
    show_help
    exit 1
  fi

  echo "معلومات الحزمة: $pkg_name"
  echo "================================"
  if [ -f "$INSTALLED_FLAG" ] && grep -qx "$pkg_name" "$INSTALLED_FLAG" 2>/dev/null; then
    echo "الحالة: مثبتة"
  else
    echo "الحالة: غير مثبتة"
  fi
  echo ""
  echo "وصف الحزمة: غير متوفر (سيتم إضافته في الإصدارات القادمة)"
  echo "المصدر: https://github.com/omar-priv/omaros1/releases"
}

# المعالجة الرئيسية
main() {
  local cmd="$1"
  shift

  case "$cmd" in
    list|ls) list_packages ;;
    install) install_package "$1" ;;
    remove|rm|uninstall) remove_package "$1" ;;
    update|upgrade) update_packages ;;
    search) search_packages "$1" ;;
    info) package_info "$1" ;;
    help|--help|-h|*) show_help ;;
  esac
}

main "$@"