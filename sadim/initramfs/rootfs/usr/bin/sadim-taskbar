#!/bin/sh
# Sadim OS — Taskbar (Windows 10 Style)
# شريط المهام الشبيه بـ Windows 10 Taskbar
# يحتوي على زر Start، معلومات النظام، الساعة، ومؤشر اللغة
# يعمل كتطبيق shell في محطة أوامر منفصلة

set -e

INTERVAL="${1:-1}"

log() { echo "[taskbar] $*"; }

show_taskbar() {
  clear
  echo "╔═══════════════════════════════════════════════════════════════════════╗"
  echo "║  [ابدأ (Start)]  📁  📝  🧮  📊  ⚙️                                    ║"
  echo "╠═══════════════════════════════════════════════════════════════════════╣"
  echo "║  Sadim OS v0.2-daily  |  Administrator  |  ar_SA.UTF-8  |  ENG    ║"
  echo "╠═══════════════════════════════════════════════════════════════════════╣"
  echo "║  CPU: $(get_cpu)%  |  RAM: $(get_ram)  |  Disk: $(get_disk)  |  $(get_time)  ║"
  echo "╚═══════════════════════════════════════════════════════════════════════╝"
  echo ""
  echo "  التطبيقات المثبتة في شريط المهام:"
  echo "  1. مستكشف الملفات (File Explorer)"
  echo "  2. المفكرة (Notepad)"
  echo "  3. الحاسبة (Calculator)"
  echo "  4. مدير المهام (Task Manager)"
  echo "  5. الإعدادات (Settings)"
  echo ""
  echo "  الأوامر: [1-5] — تشغيل تطبيق | s — قائمة ابدأ | q — خروج"
  echo -n "  اختر الأمر: "
}

get_cpu() {
  if [ -r /proc/stat ]; then
    local line=$(head -1 /proc/stat)
    local parts=($line)
    local user=${parts[1]:-0}
    local nice=${parts[2]:-0}
    local system=${parts[3]:-0}
    local idle=${parts[4]:-0}
    local total=$((user + nice + system + idle))
    local active=$((user + nice + system))
    if [ "$total" -gt 0 ]; then
      echo "$(( active * 100 / total ))%"
    else
      echo "0%"
    fi
  else
    echo "0%"
  fi
}

get_ram() {
  if [ -r /proc/meminfo ]; then
    local total=$(grep '^MemTotal:' /proc/meminfo | awk '{print $2}')
    local available=$(grep '^MemAvailable:' /proc/meminfo | awk '{print $2}')
    local used=$((total - available))
    local pct=$(( used * 100 / total ))
    echo "${used}KB / ${total}KB (${pct}%)"
  else
    echo "غير متاح"
  fi
}

get_disk() {
  if command -v df >/dev/null 2>&1; then
    df -h / 2>/dev/null | tail -1 | awk '{print $5" مستخدم"}'
  else
    echo "غير متاح"
  fi
}

get_time() {
  date '+%H:%M %p' 2>/dev/null || date '+%H:%M'
}

# حلقة البرنامج الرئيسي
while true; do
  show_taskbar
  read -t "$INTERVAL" cmd || true
  if [ -n "$cmd" ]; then
    case "$cmd" in
      q|Q)
        echo "تم إغلاق شريط المهام."
        exit 0
        ;;
      s|S)
        if [ -x /usr/bin/sadim-start-menu ]; then
          /usr/bin/sadim-start-menu
        else
          echo "قائمة ابدأ غير متوفرة"
          sleep 2
        fi
        ;;
      1)
        if [ -x /usr/bin/sadim-file-explorer ]; then
          /usr/bin/sadim-file-explorer &
        else
          echo "مستكشف الملفات غير متوفر"
          sleep 2
        fi
        ;;
      2)
        if [ -x /usr/bin/sadim-notepad ]; then
          /usr/bin/sadim-notepad &
        else
          echo "المفكرة غير متوفرة"
          sleep 2
        fi
        ;;
      3)
        if [ -x /usr/bin/sadim-calculator ]; then
          /usr/bin/sadim-calculator &
        else
          echo "الحاسبة غير متوفرة"
          sleep 2
        fi
        ;;
      4)
        if [ -x /usr/bin/sadim-task-manager ]; then
          /usr/bin/sadim-task-manager &
        else
          echo "مدير المهام غير متوفر"
          sleep 2
        fi
        ;;
      5)
        if [ -x /usr/bin/sadim-settings ]; then
          /usr/bin/sadim-settings &
        else
          echo "الإعدادات غير متوفرة"
          sleep 2
        fi
        ;;
      *)
        echo "أمر غير معروف"
        sleep 1
        ;;
    esac
  fi
done