#!/bin/sh
# Sadim OS — Calculator (Windows 10 Style)
# حاسبة شبيهة بـ Windows Calculator للمستخدم المبتدئ
# دعم العمليات الحسابية الأساسية والذاكرة

set -e

MEMORY=0
CURRENT="0"
PENDING_OP=""
PENDING_VALUE=0
WAITING=0

log() { echo "[calculator] $*"; }

show_screen() {
  clear
  echo "================================================"
  echo "   الحاسبة — Sadim OS (Windows 10 Style)"
  echo "================================================"
  echo ""
  echo "  الشاشة: $CURRENT"
  if [ -n "$PENDING_OP" ] && [ "$WAITING" -eq 1 ]; then
    echo "  العملية: $PENDING_VALUE $PENDING_OP ?"
  fi
  echo ""
  echo "  الذاكرة: $MEMORY"
  echo ""
  echo "  الأزرار:"
  echo "  7 8 9 /      MC MR M- M+"
  echo "  4 5 6 *      C (مسح)"
  echo "  1 2 3 -"
  echo "  0 . = +"
  echo ""
  echo "  الأوامر:"
  echo "  [0-9] — إدخال رقم"
  echo "  + - * / — عملية حسابية"
  echo "  = — نتيجة"
  echo "  C — مسح كل شيء"
  echo "  MC — استدعاء الذاكرة"
  echo "  M+ — إضافة للذاكرة"
  echo "  M- — طرح من الذاكرة"
  echo "  . — نقطة عشرية"
  echo "  q — خروج"
  echo ""
  echo -n  "  اختر الأمر: "
}

process_input() {
  local input="$1"

  case "$input" in
    q|Q)
      echo "تم إغلاق الحاسبة."
      exit 0
      ;;
    c|C)
      CURRENT="0"
      PENDING_OP=""
      PENDING_VALUE=0
      WAITING=0
      ;;
    "."|"،")
      if echo "$CURRENT" | grep -q '\.'; then
        : # تحتوي بالفعل على نقطة
      else
        CURRENT="${CURRENT}."
      fi
      ;;
    [0-9])
      if [ "$CURRENT" = "0" ] || [ "$WAITING" -eq 1 ]; then
        CURRENT="$input"
        WAITING=0
      else
        CURRENT="${CURRENT}${input}"
      fi
      ;;
    "+"|"-"|"*"|"/")
      if [ "$WAITING" -eq 0 ] && [ -n "$CURRENT" ]; then
        # تنفيذ العملية المعلقة إذا وجدت
        if [ -n "$PENDING_OP" ]; then
          local result
          result=$(do_calc "$PENDING_VALUE" "$PENDING_OP" "$CURRENT")
          CURRENT="$result"
        fi
        PENDING_VALUE="$CURRENT"
        PENDING_OP="$input"
        WAITING=1
      else
        PENDING_VALUE="$CURRENT"
        PENDING_OP="$input"
        WAITING=1
      fi
      ;;
    "=")
      if [ -n "$PENDING_OP" ] && [ "$WAITING" -eq 1 ]; then
        CURRENT=$(do_calc "$PENDING_VALUE" "$PENDING_OP" "$CURRENT")
        PENDING_OP=""
        WAITING=1
      fi
      ;;
    mc|MC)
      CURRENT="$MEMORY"
      WAITING=1
      ;;
    m+|M+)
      MEMORY=$(echo "$MEMORY + $CURRENT" | bc 2>/dev/null || echo "$MEMORY")
      WAITING=1
      ;;
    m-|M-)
      MEMORY=$(echo "$MEMORY - $CURRENT" | bc 2>/dev/null || echo "$MEMORY")
      WAITING=1
      ;;
    *)
      echo "أمر غير معروف: $input"
      sleep 1
      ;;
  esac
}

do_calc() {
  local a="$1"
  local op="$2"
  local b="$3"

  case "$op" in
    "+") echo "$a + $b" | bc 2>/dev/null || echo "0" ;;
    "-") echo "$a - $b" | bc 2>/dev/null || echo "0" ;;
    "*") echo "$a * $b" | bc 2>/dev/null || echo "0" ;;
    "/")
      if [ "$b" = "0" ]; then
        echo "خطأ: قسمة على صفر"
      else
        echo "scale=4; $a / $b" | bc 2>/dev/null || echo "0"
      fi
      ;;
    *) echo "$b" ;;
  esac
}

# حلقة البرنامج الرئيسي
while true; do
  show_screen
  read input
  process_input "$input"
done