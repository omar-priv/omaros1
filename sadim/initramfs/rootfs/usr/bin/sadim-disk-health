#!/bin/sh
# Sadim OS — Disk Health Monitor (مراقبة صحة القرص SMR)
# مراقبة صحة الهارد الميكانيكي SMR وتقديم تقارير الأداء
# لا أدوات خارجية — الأوامر اليدوية فقط

set -e

DISK_DEVICE="${1:-/dev/sda}"
LOG_FILE="/var/log/sadim-disk-health.log"

log() { echo "[disk-health] $*"; echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG_FILE" 2>/dev/null || true; }

show_help() {
  echo "Sadim OS Disk Health Monitor — مراقبة صحة القرص SMR"
  echo ""
  echo "الاستخدام: sadim-disk-health [قرص] [أمر]"
  echo ""
  echo "الأوامر:"
  echo "  info      — معلومات القرص"
  echo "  health    — حالة صحة القرص (S.M.A.R.T)"
  echo "  perf      — أداء القراءة/الكتابة"
  echo "  monitor   — مراقبة مستمرة (كل 5 ثوانٍ)"
  echo "  help      — عرض هذه المساعدة"
  echo ""
  echo "أمثلة:"
  echo "  sadim-disk-health /dev/sda info"
  echo "  sadim-disk-health /dev/sda health"
  echo "  sadim-disk-health /dev/sda perf"
  echo ""
  echo "⚠️  ملاحظة: هذا القرص SMR — الكتابة المتكررة قد تبطئ الأداء"
}

show_info() {
  local disk="$1"
  echo "معلومات القرص: $disk"
  echo "================================"

  if [ -b "$disk" ]; then
    echo "الجهاز موجود: نعم"
    echo ""
    if command -v blockdev >/dev/null 2>&1; then
      local size
      size=$(blockdev --getsize64 "$disk" 2>/dev/null || echo "غير متاح")
      echo "الحجم: $size بايت ($(( size / 1024 / 1024 / 1024 )) GB)"
    fi
    if [ -r "/sys/block/$(basename "$disk")/queue/rotational" ]; then
      local rotational
      rotational=$(cat "/sys/block/$(basename "$disk")/queue/rotational" 2>/dev/null || echo "غير متاح")
      if [ "$rotational" = "1" ]; then
        echo "النوع: قرص mechanism (HDD)"
        echo "⚠️  إذا كان SMR: الكتابة المتسلسلة بطيئة — تجنب الكتابة العشوائية"
      else
        echo "النوع: قرص الحالة الصلبة (SSD)"
      fi
    fi
    if command -v lsblk >/dev/null 2>&1; then
      echo ""
      echo "الأقسام:"
      lsblk "$disk" 2>/dev/null || echo "لا يمكن عرض الأقسام"
    fi
  else
    echo "الجهاز غير موجود أو ليس قرصاً)"
    echo "الأقراص المتاحة:"
    lsblk 2>/dev/null | grep -E 'disk' || echo "لا يمكن عرض الأقراص"
  fi
  echo ""
  echo "للحصول على تفاصيل أكثر: sadim-disk-health $disk health"
}

show_health() {
  local disk="$1"
  echo "صحة القرص: $disk"
  echo "================================"

  if ! [ -b "$disk" ]; then
    echo "الجهاز غير موجود"
    return 1
  fi

  if command -v smartctl >/dev/null 2>&1; then
    echo "قراءة بيانات S.M.A.R.T…"
    smartctl -H "$disk" 2>/dev/null || echo "لا يمكن قراءة بيانات S.M.A.R.T (قد لا يدعمها القرص)"
    echo ""
    smartctl -A "$disk" 2>/dev/null | head -30 || echo "لا يمكن قراءة سمات S.M.A.R.T"
  else
    echo "أداة smartctl غير مثبتة"
    echo "للتثبيت: أضف smartmontools إلى تكوين Buildroot"
  fi
  echo ""
  echo "⚠️  قرص SMR: صحة القرص تتدهور مع الكتابة العشوائية المتكررة"
  echo "  التوصية: استخدم zRAM بدلاً من swap على القرص"
  echo "  التوصية: فعّل noatime لتقليل كتابات وقت الوصول"
}

show_perf() {
  local disk="$1"
  echo "أداء القرص: $disk"
  echo "================================"

  if ! [ -b "$disk" ]; then
    echo "الجهاز غير موجود"
    return 1
  fi

  echo "⚠️  تحذير: اختبار الكتابة قد يؤثر على قرص SMR"
  echo ""
  echo "قراءة الأداء (قراءة تسلسلية):"
  if command -v dd >/dev/null 2>&1; then
    dd if="$disk" of=/dev/null bs=1M count=100 2>&1 | tail -1 || echo "لا يمكن اختبار القراءة"
  else
    echo "أداة dd غير مثبتة"
  fi
  echo ""
  echo "⚠️  اختبار الكتابة معطل افتراضياً لحماية قرص SMR"
  echo "  للاختبار اليدوي: dd if=/dev/zero of=/tmp/test bs=1M count=50 conv=fdatasync"
  echo ""
  echo "نصائح لتحسين أداء قرص SMR:"
  echo "  1. استخدم zRAM بدلاً من swap على القرص"
  echo "  2. فعّل noatime/nodiratime على جميع الأقسام"
  echo "  3. اجعل الملفات المؤقتة في tmpfs (RAM)"
  echo "  4. تجنب خدمات الفهرسة والبحث في القرص"
}

monitor_disk() {
  local disk="$1"
  echo "مراقبة القرص: $disk (كل 5 ثوانٍ — اضغط Ctrl+C للإيقاف)"
  echo "================================"

  while true; do
    clear
    echo "مراقبة القرص: $disk — $(date '+%H:%M:%S')"
    echo ""
    if [ -r "/sys/block/$(basename "$disk")/stat" ]; then
      cat "/sys/block/$(basename "$disk")/stat" 2>/dev/null | awk '{
        reads=$1; reads_merged=$2; sectors_read=$3; read_ms=$4;
        writes=$5; writes_merged=$6; sectors_written=$7; write_ms=$8;
        ios_in_progress=$9; io_ms=$10; io_weighted_ms=$11;
        printf "قراءات: %d | كتابات: %d | وقت القراءة: %d ms | وقت الكتابة: %d ms\n",
          reads, writes, read_ms, write_ms
      }'
    else
      echo "لا يمكن قراءة إحصائيات القرص"
    fi
    echo ""
    echo "الذاكرة (للتحقق من zRAM):"
    free -m 2>/dev/null | head -2 || cat /proc/meminfo 2>/dev/null | head -5
    echo ""
    echo "اضغط Ctrl+C للإيقاف"
    sleep 5
  done
}

main() {
  local disk="$1"
  local cmd="$2"

  if [ -z "$disk" ]; then
    show_help
    exit 0
  fi

  case "$cmd" in
    info) show_info "$disk" ;;
    health) show_health "$disk" ;;
    perf) show_perf "$disk" ;;
    monitor) monitor_disk "$disk" ;;
    help|--help|-h|*) show_help ;;
  esac
}

main "$@"