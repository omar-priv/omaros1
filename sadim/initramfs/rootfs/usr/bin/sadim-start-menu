#!/bin/sh
# Sadim OS — Start Menu (Windows 10 Style)
# قائمة ابدأ الشبيهة بـ Windows 10 Start Menu
# تعرض التطبيقات الأساسية وتسهل تشغيلها

set -e

show_menu() {
  clear
  echo "================================================"
  echo "   قائمة ابدأ — Sadim OS (Windows 10 Style)"
  echo "================================================"
  echo ""
  echo "  المستخدم: sadim (Administrator)"
  echo ""
  echo "  التطبيقات:"
  echo "  ----------------"
  echo "  1. 📁 مستكشف الملفات (File Explorer)"
  echo "  2. 📝 المفكرة (Notepad)"
  echo "  3. 🧮 الحاسبة (Calculator)"
  echo "  4. 📊 مدير المهام (Task Manager)"
  echo "  5. ⚙️ الإعدادات (Settings)"
  echo "  6. 🖥️ محطة الأوامر (Terminal)"
  echo "  7. 🌐 متصفح الويب (Browser)"
  echo "  8. 🍷 تشغيل تطبيق Windows (.exe) via Wine"
  echo ""
  echo "  ------------------"
  echo "  9. ⏻ إيقاف التشغيل (Shutdown)"
  echo "  0. 🔄 إعادة التشغيل (Restart)"
  echo ""
  echo -n "  اختر الرقم: "
}

launch_app() {
  local choice="$1"

  case "$choice" in
    1)
      if [ -x /usr/bin/sadim-file-explorer ]; then
        /usr/bin/sadim-file-explorer
      else
        echo "مستكشف الملفات غير متوفر"
        sleep 2
      fi
      ;;
    2)
      if [ -x /usr/bin/sadim-notepad ]; then
        /usr/bin/sadim-notepad
      else
        echo "المفكرة غير متوفرة"
        sleep 2
      fi
      ;;
    3)
      if [ -x /usr/bin/sadim-calculator ]; then
        /usr/bin/sadim-calculator
      else
        echo "الحاسبة غير متوفرة"
        sleep 2
      fi
      ;;
    4)
      if [ -x /usr/bin/sadim-task-manager ]; then
        /usr/bin/sadim-task-manager
      else
        echo "مدير المهام غير متوفر"
        sleep 2
      fi
      ;;
    5)
      if [ -x /usr/bin/sadim-settings ]; then
        /usr/bin/sadim-settings
      else
        echo "الإعدادات غير متوفرة"
        sleep 2
      fi
      ;;
    6)
      if [ -x /bin/sh ]; then
        /bin/sh
      else
        echo "محطة الأوامر غير متوفرة"
        sleep 2
      fi
      ;;
    7)
      if [ -x /opt/brave/brave-browser ]; then
        /opt/brave/brave-browser &
      elif command -v lynx >/dev/null 2>&1; then
        lynx
      elif command -v links >/dev/null 2>&1; then
        links
      else
        echo "متصفح الويب غير مثبت. يتم تثبيت Brave تلقائياً عند الإقلاع."
        sleep 2
      fi
      ;;
    8)
      echo -n "مسار ملف .exe: "
      read exe_path
      if [ -n "$exe_path" ] && [ -x /usr/bin/sadim-wine ]; then
        /usr/bin/sadim-wine "$exe_path"
      else
        echo "ملف غير موجود أو Wine غير مثبت"
        sleep 2
      fi
      ;;
    9)
      echo "إيقاف النظام..."
      sleep 1
      poweroff 2>/dev/null || reboot -f 2>/dev/null || echo "لا يمكن إيقاف النظام"
      exit 0
      ;;
    0)
      echo "إعادة التشغيل..."
      sleep 1
      reboot -f 2>/dev/null || echo "لا يمكن إعادة التشغيل"
      exit 0
      ;;
    *)
      echo "اختيار غير صحيح"
      sleep 1
      ;;
  esac
}

# حلقة البرنامج الرئيسي
while true; do
  show_menu
  read choice
  launch_app "$choice"

  # إذا لم يكن الخيار إغلاق النظام، ارجع للقائمة
  case "$choice" in
    9|0) exit 0 ;;
  esac
done