#!/bin/sh
# Sadim OS — Help (مساعدة النظام)
# دليل استخدام نظام سديم OS للمستخدم المبتدئ
# شبيهة بـ Windows Help and Support

set -e

show_help() {
  clear
  echo "================================================"
  echo "   مساعدة sistema Sadim OS"
  echo "================================================"
  echo ""
  echo "  أهلاً بك في نظام سديم OS (Sadim OS)"
  echo "  نظام تشغيل مخصص لجهاز Acer E5-576G"
  echo ""
  echo "  الإصدار: 0.2-daily"
  echo ""
  echo "  التطبيقات الأساسية:"
  echo "  ----------------"
  echo "    📁 مستكشف الملفات — إدارة الملفات والمجلدات"
  echo "    📝 المفكرة — إنشاء وتحرير الملفات النصية"
  echo "    🧮 الحاسبة — العمليات الحسابية الأساسية"
  echo "    📊 مدير المهام — مراقبة العمليات والموارد"
  echo "    ⚙️ الإعدادات — تكوين النظام والشبكة والطاقة"
  echo "    🖥️ محطة الأوامر — تشغيل أوامر النظام مباشرة"
  echo "    🌐 متصفح الويب — تصفح الإنترنت (Brave)"
  echo "    🍷 تشغيل تطبيقات Windows (.exe) عبر Wine"
  echo "    🔍 بحث النظام — البحث عن الملفات والتطبيقات"
  echo "    ℹ️ معلومات النظام — عرض تفاصيل العتاد والنظام"
  echo ""
  echo "  keyboard shortcuts (اختصارات لوحة المفاتيح):"
  echo "  ----------------"
  echo "    Alt+Shift — تبديل اللغة بين العربية والإنجليزية"
  echo "    Ctrl+C — إلغاء العملية الجارية"
  echo "    Ctrl+D — إنهاء الجلسة الحالية"
  echo ""
  echo "  نصائح للاستخدام اليومي:"
  echo "  ----------------"
  echo "    1. النظام يعمل من الذاكرة (RAM) — التغييرات تضيع عند إعادة التشغيل"
  echo "    2. لا يتم لمس أقسام Windows الداخلية — ملفاتك آمنة"
  echo "    3. zRAM مفعّل افتراضياً بدلاً من swap على الهارد الميكانيكي"
  echo "    4. استخدم sudo للإدارة cuando تحتاج إلى صلاحيات root"
  echo "    5. تطبيقات Windows (.exe) تعمل عبر Wine مع تحذير أمني"
  echo ""
  echo "  للحصول على المساعدة:"
  echo "  ----------------"
  echo "    المستودع: https://github.com/omar-priv/omaros1"
  echo "    الإبلاغ عن مشكلة: https://github.com/omar-priv/omaros1/issues"
  echo ""
  echo "اضغط Enter للعودة…"
  read
}

# المعالجة الرئيسية
main() {
  show_help
}

main "$@"