#!/bin/sh
# Sadim OS — Notepad (Windows 10 Style)
# مفكرة شبيهة بـ Windows Notepad للمستخدم المبتدئ
#支持 إنشاء، فتح، حفظ، وتحرير ملفات نصية UTF-8

set -e

FILE="${1:-}"
EDITOR="${EDITOR:-/bin/vi}"
CLIPBOARD_FILE="/tmp/sadim-notepad-clipboard"

log() { echo "[notepad] $*"; }

show_help() {
  echo "Sadim OS Notepad — مفكرة شبيهة بـ Windows Notepad"
  echo ""
  echo "الاستخدام: sadim-notepad [ملف]"
  echo ""
  echo "الأوامر داخل المحرر:"
  echo "  s — حفظ الملف (Save)"
  echo "  o — فتح ملف آخر (Open)"
  echo "  n — ملف جديد (New)"
  echo "  q — خروج بدون حفظ (Quit)"
  echo "  wq — حفظ وخروج (Write & Quit)"
  echo ""
}

edit_file() {
  local target="$1"

  if [ -n "$target" ] && [ -f "$target" ]; then
    log "فتح الملف: $target"
    cp "$target" "$CLIPBOARD_FILE.edit" 2>/dev/null || true
  else
    target="/tmp/sadim-notepad-draft.txt"
    touch "$target" 2>/dev/null || true
  fi

  while true; do
    clear
    echo "================================================"
    echo "   المفكرة — Sadim OS (Windows 10 Style)"
    echo "================================================"
    echo "  الملف: $target"
    echo ""
    if [ -f "$target" ] && [ -r "$target" ]; then
      echo "  محتوى الملف:"
      echo "  ----------------"
      cat -n "$target" 2>/dev/null || echo "  (لا يمكن قراءة الملف)"
      echo "  ----------------"
    else
      echo "  (ملف جديد فارغ)"
    fi
    echo ""
    echo "  الأوامر: s=حفظ o=فتح n=جديد wq=حفظochروج q=خروج"
    echo -n  "  اختر الأمر: "
    read cmd

    case "$cmd" in
      s|S)
        # الحفظ يتم تلقائياً عند الخروج مع wq
        echo "يتم حفظ التغييرات عند الخروج باستخدام wq"
        sleep 1
        ;;
      o|O)
        echo -n "مسار الملف للفتح: "
        read new_file
        if [ -n "$new_file" ] && [ -f "$new_file" ]; then
          target="$new_file"
        else
          echo "الملف غير موجود"
          sleep 1
        fi
        ;;
      n|N)
        target="/tmp/sadim-notepad-draft.txt"
        > "$target"
        echo "تم إنشاء ملف جديد"
        sleep 1
        ;;
      wq|WQ)
        # فتح المحرر للتعديل ثم الحفظ
        if [ -x "$EDITOR" ]; then
          "$EDITOR" "$target"
        else
          /bin/vi "$target"
        fi
        echo "تم حفظ التغييرات في: $target"
        sleep 1
        break
        ;;
      q|Q)
        echo "تم إغلاق المفكرة بدون حفظ."
        break
        ;;
      *)
        echo "أمر غير معروف"
        sleep 1
        ;;
    esac
  done
}

if [ -n "$FILE" ]; then
  edit_file "$FILE"
else
  show_help
  edit_file ""
fi