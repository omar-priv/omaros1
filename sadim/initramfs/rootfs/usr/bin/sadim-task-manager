#!/bin/sh
# Sadim OS — Task Manager (Windows 10 Style)
# مدير المهام الشبيه بـ Windows Task Manager
# يعرض العمليات، استخدام الذاكرة، المعالج، والقرص
# قراءة من /proc مباشرة

set -e

REFRESH_INTERVAL="${1:-2}"

log() { echo "[task-manager] $*"; }

show_screen() {
  clear
  echo "================================================"
  echo "   مدير المهام — Sadim OS (Windows 10 Style)"
  echo "================================================"
  echo ""

  # قراءة ملخص الذاكرة
  local mem_total=0 mem_available=0 mem_used=0 mem_pct=0
  if [ -r /proc/meminfo ]; then
    mem_total=$(grep '^MemTotal:' /proc/meminfo | awk '{print $2}')
    mem_available=$(grep '^MemAvailable:' /proc/meminfo | awk '{print $2}')
    if [ -n "$mem_total" ] && [ -n "$mem_available" ]; then
      mem_used=$((mem_total - mem_available))
      mem_pct=$(( mem_used * 100 / mem_total ))
    fi
  fi

  # قراءة تحميل المعالج
  local cpu_pct=0
  if [ -r /proc/stat ]; then
    local line=$(head -1 /proc/stat)
    local parts=($line)
    local user=${parts[1]:-0}
    local nice=${parts[2]:-0}
    local system=${parts[3]:-0}
    local idle=${parts[4]:-0}
    local total=$((user + nice + system + idle))
    local active=$((user + nice + system))
    if [ "$total" -gt 0 ]; then
      cpu_pct=$(( active * 100 / total ))
    fi
  fi

  echo "  المعالج (CPU): ${cpu_pct}%   |   الذاكرة (RAM): ${mem_used} KB / ${mem_total} KB (${mem_pct}%)"
  echo ""
  echo "  العمليات الجارية:"
  echo "  ----------------"
  echo "  PID    المستخدم    الذاكرة(KB)    الحالة    الاسم"
  echo "  ------------------------------------------------"

  # عرض العمليات (أول 20)
  local count=0
  for pid_dir in /proc/[0-9]*; do
    local pid=$(basename "$pid_dir")
    local name="unknown"
    local user="?"
    local memkb="0"
    local state="?"

    # قراءة اسم العملية
    if [ -r "$pid_dir/cmdline" ]; then
      name=$(tr '\0' ' ' < "$pid_dir/cmdline" 2>/dev/null | awk '{print $1}')
      if [ -z "$name" ]; then
        name="pid-$pid"
      fi
      if [ ${#name} -gt 25 ]; then
        name="${name:0:22}..."
      fi
    fi

    # قراءة المستخدم
    if [ -r "$pid_dir/status" ]; then
      user=$(grep '^Uid:' "$pid_dir/status" 2>/dev/null | awk '{print $2}')
      state=$(grep '^State:' "$pid_dir/status" 2>/dev/null | awk '{print $2}')
      memkb=$(grep '^VmRSS:' "$pid_dir/status" 2>/dev/null | awk '{print $2}')
    fi

    [ -z "$memkb" ] && memkb="0"
    [ -z "$user" ] && user="0"

    echo "  $pid    $user    $memkb    $state    $name"

    count=$((count + 1))
    if [ "$count" -ge 20 ]; then
      break
    fi
  done

  echo ""
  echo "  ----------------"
  echo "  الأوامر: k [PID] — إنهاء مهمة | r — تحديث | q — خروج"
  echo -n  "  اختر الأمر: "
}

process_command() {
  local cmd="$1"
  local rest="${cmd#* }"

  case "$cmd" in
    q|Q)
      echo "تم إغلاق مدير المهام."
      exit 0
      ;;
    r|R)
      # تحديث الشاشة
      ;;
    k|K)
      if [ -n "$rest" ]; then
        if kill -15 "$rest" 2>/dev/null; then
          echo "تم إرسال إشارة إنهاء لـ PID: $rest"
        else
          echo "فشل إنهاء العملية: $rest"
        fi
        sleep 1
      else
        echo "الرجاء تحديد رقم العملية (PID)"
        sleep 1
      fi
      ;;
    *)
      echo "أمر غير معروف: $cmd"
      sleep 1
      ;;
  esac
}

# حلقة البرنامج الرئيسي
while true; do
  show_screen
  read -t "$REFRESH_INTERVAL" cmd || true
  if [ -n "$cmd" ]; then
    process_command "$cmd"
  fi
done