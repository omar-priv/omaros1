#!/bin/sh
# Sadim OS — File Explorer (Windows 10 Style)
# مستكشف الملفات الشبيه بـ Windows Explorer للمستخدم المبتدئ
# واجهة نصية متقدمة مع دعم التنقل، النسخ، الحذف، والإنشاء
# يعمل على Qt6 LinuxFB عبر واجهة محطات أوامر متقدمة

set -e

CURRENT_DIR="${1:-$HOME}"
HISTORY_FILE="/tmp/sadim-explorer-history"
CLIPBOARD_FILE="/tmp/sadim-explorer-clipboard"
CLIPBOARD_ACTION=""

log() { echo "[explorer] $*"; }

# تحديث سجل المواقع
add_history() {
  echo "$CURRENT_DIR" >> "$HISTORY_FILE" 2>/dev/null || true
}

# عرض الشاشة الرئيسية
show_screen() {
  clear
  echo "================================================"
  echo "   مستكشف الملفات — Sadim OS (Windows 10 Style)"
  echo "================================================"
  echo ""
  echo "  المسار الحالي: $CURRENT_DIR"
  echo ""
  echo "  محتوى المجلد:"
  echo "  ----------------"

  # عرض المجلدات أولاً ثم الملفات
  local count=1
  local has_items=0
  for item in "$CURRENT_DIR"/*; do
    # التحقق من وجود ملفات فعلية (تجنب مشكلة globbing عندما يكون المجلد فارغاً)
    [ -e "$item" ] || continue
    has_items=1
    local name=$(basename "$item")
    if [ -d "$item" ]; then
      echo "  [$count] 📁 $name  (مجلد)"
    else
      local size=$(du -h "$item" 2>/dev/null | cut -f1)
      echo "  [$count] 📄 $name  ($size)"
    fi
    count=$((count + 1))
  done

  if [ "$has_items" -eq 0 ]; then
    echo "  (المجلد فارغ)"
  fi

  echo ""
  echo "  ----------------"
  echo "  الأوامر:"
  echo "  [رقم] — فتح مجلد أو ملف"
  echo "  b — العودة للوراء (Back)"
  echo "  h — الصفحة الرئيسية (Home)"
  echo "  c — إنشاء مجلد جديد (Create Folder)"
  echo "  n — إنشاء ملف جديد (New File)"
  echo "  d — حذف عنصر (Delete)"
  echo "  r — إعادة تسمية (Rename)"
  echo "  x — نسخ (Copy)"
  echo "  v — لصق (Paste)"
  echo "  q — خروج (Quit)"
  echo ""
  echo -n  "  اختر الأمر: "
}

# معالجة الأمر
process_command() {
  local cmd="$1"

  case "$cmd" in
    q|Q)
      echo "تم إغلاق مستكشف الملفات."
      exit 0
      ;;
    b|B)
      # العودة للمجلد الأب
      CURRENT_DIR=$(dirname "$CURRENT_DIR")
      ;;
    h|H)
      CURRENT_DIR="$HOME"
      ;;
    c|C)
      echo -n "اسم المجلد الجديد: "
      read folder_name
      if [ -n "$folder_name" ]; then
        mkdir -p "$CURRENT_DIR/$folder_name" 2>/dev/null && \
          echo "تم إنشاء المجلد: $folder_name" || \
          echo "فشل إنشاء المجلد"
        sleep 1
      fi
      ;;
    n|N)
      echo -n "اسم الملف الجديد: "
      read file_name
      if [ -n "$file_name" ]; then
        touch "$CURRENT_DIR/$file_name" 2>/dev/null && \
          echo "تم إنشاء الملف: $file_name" || \
          echo "فشل إنشاء الملف"
        sleep 1
      fi
      ;;
    d|D)
      echo -n "رقم العنصر للحذف: "
      read item_num
      local item=$(get_item_by_number "$item_num")
      if [ -n "$item" ]; then
        # حماية من حذف الجذر أو مسارات النظام الحساسة
        case "$item" in
          ..|.*|/*) echo "لا يمكن حذف هذا العنصر لأسباب أمنية" ; sleep 1 ;;
          *)
            echo -n "تأكيد حذف $item؟ (y/n): "
            read confirm
            if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
              rm -rf "$CURRENT_DIR/$item" 2>/dev/null && \
                echo "تم الحذف: $item" || echo "فشل الحذف"
              sleep 1
            fi
            ;;
        esac
      fi
      ;;
    r|R)
      echo -n "رقم العنصر لإعادة التسمية: "
      read item_num
      local item=$(get_item_by_number "$item_num")
      if [ -n "$item" ]; then
        echo -n "الاسم الجديد: "
        read new_name
        if [ -n "$new_name" ]; then
          mv "$CURRENT_DIR/$item" "$CURRENT_DIR/$new_name" 2>/dev/null && \
            echo "تم إعادة التسمية: $new_name" || echo "فشل إعادة التسمية"
          sleep 1
        fi
      fi
      ;;
    x|X)
      echo -n "رقم العنصر للنسخ: "
      read item_num
      local item=$(get_item_by_number "$item_num")
      if [ -n "$item" ]; then
        echo "$CURRENT_DIR/$item" > "$CLIPBOARD_FILE"
        CLIPBOARD_ACTION="copy"
        echo "تم النسخ: $item"
        sleep 1
      fi
      ;;
    v|V)
      if [ -f "$CLIPBOARD_FILE" ] && [ "$CLIPBOARD_ACTION" = "copy" ]; then
        local source=$(cat "$CLIPBOARD_FILE")
        cp -r "$source" "$CURRENT_DIR/" 2>/dev/null && \
          echo "تم اللصق: $(basename "$source")" || echo "فشل اللصق"
        sleep 1
      else
        echo "لا يوجد عنصر منسوخ"
        sleep 1
      fi
      ;;
    *)
      # محاولة فتح عنصر برقم
      local item=$(get_item_by_number "$cmd")
      if [ -n "$item" ]; then
        if [ -d "$CURRENT_DIR/$item" ]; then
          add_history
          CURRENT_DIR="$CURRENT_DIR/$item"
        else
          # فتح الملف مع التطبيق الافتراضي
          if [ -x /usr/bin/sadim-notepad ]; then
            /usr/bin/sadim-notepad "$CURRENT_DIR/$item" &
          else
            echo "لا يمكن فتح الملف: لا يوجد تطبيق افتراضي"
            sleep 2
          fi
        fi
      else
        echo "أمر غير معروف: $cmd"
        sleep 1
      fi
      ;;
  esac
}

# جلب العنصر حسب الرقم
get_item_by_number() {
  local num="$1"
  local count=1
  for item in "$CURRENT_DIR"/*; do
    [ -e "$item" ] || continue
    if [ "$count" -eq "$num" ]; then
      basename "$item"
      return
    fi
    count=$((count + 1))
  done
  echo ""
}

# حلقة البرنامج الرئيسي
add_history
while true; do
  show_screen
  read cmd
  process_command "$cmd"
done