#!/usr/bin/env qt6-linuxfb
// Sadim OS — File Explorer (Windows 10 Style)
// تطبيق مستكشف الملفات الشبيه بـ Windows Explorer للمستخدم المبتدئ
// واجهة مسطحة (Flat)، حواف حادة، ألوان Windows 10 الموحدة
// استهلاك منخفض للموارد — Qt6 linuxfb backend، بلا OpenGL/EGL

#include <QApplication>
#include <QMainWindow>
#include <QSplitter>
#include <QTreeView>
#include <QListView>
#include <QFileSystemModel>
#include <QToolBar>
#include <QAction>
#include <QStatusBar>
#include <QMenuBar>
#include <QMessageBox>
#include <QStyleFactory>
#include <QFontDatabase>

int main(int argc, char *argv[])
{
    QApplication app(argc, argv);
    app.setApplicationName("Sadim File Explorer");
    app.setApplicationVersion("0.2-daily");

    // خط النظام الافتراضي (يدعم العربية والإنجليزية)
    QFont font("Segoe UI", 10);
    if (!font.exactMatch()) {
        font = QFont("DejaVu Sans", 10);
    }
    app.setFont(font);
    app.setLayoutDirection(Qt::LeftToRight); // شريط المهام والتطبيقات LTR افتراضياً

    // نمط Windows 10 Flat عبر StyleSheet
    app.setStyleSheet(R"(
        QMainWindow {
            background-color: #f0f0f0;
            border: none;
        }
        QMenuBar {
            background-color: #f0f0f0;
            color: #333333;
            border-bottom: 1px solid #d0d0d0;
            padding: 2px;
        }
        QMenuBar::item {
            background: transparent;
            padding: 4px 8px;
            border: 1px solid transparent;
        }
        QMenuBar::item:selected {
            background-color: #0078D7;
            color: white;
            border: 1px solid #005a9e;
        }
        QToolBar {
            background-color: #f0f0f0;
            border: none;
            border-bottom: 1px solid #d0d0d0;
            spacing: 2px;
            padding: 2px;
        }
        QToolButton {
            background-color: transparent;
            border: 1px solid transparent;
            padding: 4px;
            min-width: 24px;
            min-height: 24px;
        }
        QToolButton:hover {
            background-color: #e0e0e0;
            border: 1px solid #d0d0d0;
        }
        QToolButton:pressed {
            background-color: #d0d0d0;
        }
        QTreeView, QListView {
            background-color: #ffffff;
            border: 1px solid #d0d0d0;
            outline: none;
        }
        QTreeView::item, QListView::item {
            padding: 4px;
            border: none;
        }
        QTreeView::item:selected, QListView::item:selected {
            background-color: #0078D7;
            color: white;
        }
        QStatusBar {
            background-color: #f0f0f0;
            color: #666666;
            border-top: 1px solid #d0d0d0;
        }
        QScrollBar:vertical {
            background-color: #f0f0f0;
            width: 12px;
            border: none;
        }
        QScrollBar::handle:vertical {
            background-color: #b0b0b0;
            min-height: 20px;
            border: none;
        }
        QScrollBar::handle:vertical:hover {
            background-color: #909090;
        }
    )");

    QMainWindow window;
    window.setWindowTitle("س dvor — مستكشف الملفات (Sadim File Explorer)");
    window.resize(900, 600);

    // قائمة التطبيقات (Menu Bar)
    QMenuBar *menuBar = window.menuBar();
    QMenu *fileMenu = menuBar->addWindowTitle("ملف (&File)");
    QAction *newAction = fileMenu->addAction("جديد (&New)");
    QAction *openAction = fileMenu->addAction("فتح (&Open)");
    QAction *exitAction = fileMenu->addAction("خروج (&Exit)");
    QObject::connect(exitAction, &QAction::triggered, &app, &QApplication::quit);

    QMenu *viewMenu = menuBar->addWindowTitle("عرض (&View)");
    QAction *detailsAction = viewMenu->addAction("تفاصيل (Details)");
    QAction *iconsAction = viewMenu->addAction("أيقونات (Icons)");

    QMenu *helpMenu = menuBar->addWindowTitle("مساعدة (&Help)");
    QAction *aboutAction = helpMenu->addAction("حول (About)");
    QObject::connect(aboutAction, &QAction::triggered, []() {
        QMessageBox::about(nullptr, "حول مستكشف الملفات",
            "Sadim OS File Explorer v0.2-daily\n"
            "واجهة شبيهة بـ Windows 10 للمستخدم المبتدئ\n"
            "بنيت على Qt6 + Wayland/weston");
    });

    // شريط الأدوات (ToolBar)
    QToolBar *toolBar = window.addToolBar("الشريط الرئيسي");
    toolBar->setMovable(false);
    QAction *backAction = toolBar->addAction("← वापस");
    QAction *forwardAction = toolBar->addAction("→ आगे");
    QAction *upAction = toolBar->addAction("↑ أعلاه");
    toolBar->addSeparator();
    QAction *refreshAction = toolBar->addAction("⟳ تحديث");

    // نموذج نظام الملفات
    QFileSystemModel *dirModel = new QFileSystemModel();
    dirModel->setRootPath(QDir::rootPath());

    QFileSystemModel *fileModel = new QFileSystemModel();
    fileModel->setRootPath(QDir::rootPath());

    // عرض الشجرة (الأ اليسار)
    QTreeView *treeView = new QTreeView();
    treeView->setModel(dirModel);
    treeView->setRootIndex(dirModel->index(QDir::homePath()));
    treeView->setAnimated(false); // إيقاف أنميشن(tree) للمحافظة على الأداء
    treeView->setIndentation(15);
    treeView->setSortingEnabled(true);

    // عرض الملفات (الأ اليمين)
    QListView *listView = new QListView();
    listView->setModel(fileModel);
    listView->setRootIndex(fileModel->index(QDir::homePath()));
    listView->setViewMode(QListView::ListMode);
    listView->setUniformItemSizes(true);
    listView->setSortingEnabled(true);

    // ربط الشجرة بعرض الملفات
    QObject::connect(treeView, &QTreeView::clicked, [=](const QModelIndex &index) {
        QModelIndex srcIndex = dirModel->index(index.row(), 0, index.parent());
        QString path = dirModel->fileInfo(srcIndex).absoluteFilePath();
        listView->setRootIndex(fileModel->setRootPath(path));
    });

    // تقسيم الشاشة (Splitter)
    QSplitter *splitter = new QSplitter(Qt::Horizontal);
    splitter->addWidget(treeView);
    splitter->addWidget(listView);
    splitter->setStretchFactor(0, 1);
    splitter->setStretchFactor(1, 3);
    splitter->setChildrenCollapsible(false);

    window.setCentralWidget(splitter);

    // شريط الحالة (Status Bar)
    QStatusBar *statusBar = window.statusBar();
    statusBar->showMessage("مستكشف الملفات جاهز — المسار: " + QDir::homePath());

    // معالجة خروج التطبيق بشكل آمن
    QObject::connect(&window, &QMainWindow::destroyed, []() {
        qDebug() << "[file-explorer] تم إغلاق مستكشف الملفات بشكل آمن";
    });

    window.show();
    return app.exec();
}