#!/bin/sh
# Sadim OS init services. Markers reflect the actual critical startup result.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mkdir -p /var/run /var/log /var/tmp /tmp /run
chmod 1777 /tmp 2>/dev/null || true
export HOME=/home/sadim
export USER=sadim
export LANG=ar_JO.UTF-8

echo "[rcS] starting Sadim OS services"
critical_failed=0
services_started=0
for s in /etc/init.d/S*; do
  [ -x "$s" ] || continue
  echo "[rcS] + $s"
  if "$s" start; then
    services_started=$((services_started + 1))
  else
    echo "[rcS] ERROR: $s failed"
    case "$s" in
      */S05-logging|*/S10-network|*/S20-seatd|*/S30-weston)
        critical_failed=$((critical_failed + 1))
        ;;
    esac
  fi
done
echo "[rcS] services completed: $services_started; critical failures: $critical_failed"
if [ "$critical_failed" -eq 0 ]; then
  echo "SADIM-ROOTFS-OK"
else
  echo "SADIM-ROOTFS-WARN"
fi
echo "[rcS] Base system startup finished. Hardware and app compatibility are not certified."
