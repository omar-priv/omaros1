#!/bin/sh
# سكربت أحداث udhcpc (سديم) — يكبس الإيجار في النظام فعلياً
[ -n "$1" ] || exit 0
case "$1" in
  deconfig)
    ifconfig "$interface" 0.0.0.0 up
    ;;
  bound|renew)
    ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}" up
    if [ -n "$router" ]; then
      while route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do :; done
      for r in $router; do route add default gw "$r" dev "$interface"; done
    fi
    : > /etc/resolv.conf
    for s in $dns; do echo "nameserver $s" >> /etc/resolv.conf; done
    echo "[udhcpc] bound: $ip on $interface"
    ;;
esac
exit 0
