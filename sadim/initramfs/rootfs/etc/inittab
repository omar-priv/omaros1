# Sadim OS — inittab v0.4 (busybox init) — Administrator تلقائياً عند الإقلاع
::sysinit:/etc/rcS
# tty1: تسجيل دخول تلقائي كمدير النظام (Administrator/root معادل) — لا كلمة مرور
tty1::respawn:/sbin/getty -n -l /bin/autologin 38400 tty1
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
