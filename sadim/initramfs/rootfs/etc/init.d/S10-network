#!/bin/sh
# Network startup is deferred until after Buildroot's S10udev device discovery.
case "$1" in
  start) echo "[net] startup deferred to S25-network (after udev settle)" ;;
  stop|restart|status) echo "[net] active service: /etc/init.d/S25-network" ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
