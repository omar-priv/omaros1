#!/bin/sh
# Hardware drivers are built into this kernel (CONFIG_*=y), not modules.
# Report what the running kernel actually exposes; never claim all devices exist.
set -u
log() { echo "[drivers] $*"; }
start_drivers() {
  log "checking built-in driver support and detected devices"
  for item in \
    "Intel graphics:/sys/bus/pci/drivers/i915" \
    "Realtek Ethernet:/sys/bus/pci/drivers/r8169" \
    "Qualcomm Wi-Fi:/sys/bus/pci/drivers/ath10k_pci" \
    "HDA audio:/sys/bus/pci/drivers/snd_hda_intel"; do
    label=\${item%%:*}
    path=\${item#*:}
    if [ -d "$path" ]; then log "$label driver registered"; else log "$label driver not registered/detected"; fi
  done
  [ -d /sys/class/power_supply ] && log "power-supply class available"
  [ -d /sys/class/thermal ] && log "thermal class available"
  [ -d /sys/bus/usb/devices ] && log "USB device bus available"
}
case "$1" in
  start) start_drivers ;;
  stop|restart) echo "[drivers] kernel built-in drivers need no service stop/reload" ;;
  status) start_drivers ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
