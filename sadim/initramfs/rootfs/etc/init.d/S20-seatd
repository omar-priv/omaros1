#!/bin/sh
# Start seatd before Weston and confirm its socket is available.
set -u
DAEMON=/usr/bin/seatd
PIDFILE=/var/run/seatd.pid
SOCKET=/run/seatd.sock
start_seatd() {
  [ -x "$DAEMON" ] || { echo "[seatd] ERROR: binary missing"; return 1; }
  mkdir -p /run /var/run
  [ -S "$SOCKET" ] && { echo "[seatd] socket already available"; return 0; }
  rm -f "$PIDFILE"
  start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- -g seat
  i=0
  while [ "$i" -lt 20 ]; do
    [ -S "$SOCKET" ] && { echo "[seatd] ready"; return 0; }
    sleep 0.5
    i=$((i + 1))
  done
  echo "[seatd] ERROR: socket did not appear"
  return 1
}
stop_seatd() {
  start-stop-daemon -K -p "$PIDFILE" 2>/dev/null || true
  rm -f "$PIDFILE"
}
case "$1" in
  start) start_seatd ;;
  stop) stop_seatd ;;
  restart) stop_seatd; sleep 1; start_seatd ;;
  status) [ -S "$SOCKET" ] && echo "seatd ready" || { echo "seatd unavailable"; exit 1; } ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
