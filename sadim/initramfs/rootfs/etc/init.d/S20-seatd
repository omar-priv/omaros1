#!/bin/sh
# Preflight for Buildroot's generated S70seatd service.
# The daemon is intentionally started by S70seatd, after early base services.
set -u
DAEMON=/usr/bin/seatd
SERVICE=/etc/init.d/S70seatd
SOCKET=/run/seatd.sock

case "$1" in
  start)
    [ -x "$DAEMON" ] || { echo "[seatd] ERROR: daemon binary missing"; exit 1; }
    [ -x "$SERVICE" ] || { echo "[seatd] ERROR: Buildroot S70seatd service missing"; exit 1; }
    grep -Eq '^video:[^:]*:28:' /etc/group || {
      echo "[seatd] ERROR: video group missing (required by S70seatd)"
      exit 1
    }
    echo "[seatd] daemon and video group verified; S70seatd will start it"
    ;;
  stop)
    [ ! -x "$SERVICE" ] || "$SERVICE" stop
    ;;
  restart)
    [ -x "$SERVICE" ] || { echo "[seatd] ERROR: Buildroot service missing"; exit 1; }
    "$SERVICE" restart
    ;;
  status)
    [ -S "$SOCKET" ] && echo "[seatd] socket ready" || {
      echo "[seatd] unavailable"; exit 1;
    }
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
