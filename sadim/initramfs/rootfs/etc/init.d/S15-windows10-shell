#!/bin/sh
# Sadim OS — Windows 10 Shell Launcher (مثل Windows Startup)
# يبدأ واجهة Windows 10-like عند الإقلاع: Weston + Taskbar + aplicaciones الأساسية
# يعمل بعد seatd و Weston — لاستخدام يومي للمبتدئ

set -u

DAEMON_DIR="/usr/bin"
PIDFILE=/var/run/sadim-shell.pid
LOG_FILE=/var/log/sadim-shell.log

log() { echo "[win10-shell] $*" | tee -a "$LOG_FILE" 2>/dev/null || echo "[win10-shell] $*"; }

start_shell() {
  log "بدء واجهة Windows 10-like لنظام سديم OS…"

  # 1. تطبيق تخصيصات Windows 10 (theme, performance, SMR protection)
  if [ -x /etc/sadim/windows10-tweaks.sh ]; then
    /etc/sadim/windows10-tweaks.sh start
  fi

  # 2. انتظار Weston socket (حتى 15 ثانية)
  log "انتظار bereit Weston compositor…"
  for i in $(seq 1 30); do
    if [ -S /run/user/0/wayland-0 ]; then
      log "Weston جاهز"
      break
    fi
    sleep 0.5
  done

  # 3. تشغيل شريط المهام (Taskbar) في الخلفية
  if [ -x "$DAEMON_DIR/sadim-taskbar" ]; then
    log "تشغيل شريط المهام (Taskbar)…"
    $DAEMON_DIR/sadim-taskbar &
    echo $! > "$PIDFILE"
  else
    log "WARN: sadim-taskbar غير موجود — شريط المهام غير متاح"
  fi

  # 4. تشغيل تطبيقات افتراضية اختيارية (يمكن للمستخدم إضافتها لاحقاً)
  # لا نفتح تطبيقات تلقائياً للحفاظ على الأداء (مثل Windows 10 Clean Install)

  log "تم بدء واجهة Windows 10-like بنجاح"
  echo "SADIM-SHELL-OK"
}

stop_shell() {
  log "إيقاف واجهة Windows 10-like…"
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
  killall sadim-taskbar 2>/dev/null || true
  killall sadim-start-menu 2>/dev/null || true
  log "تم إيقاف الواجهة"
}

case "$1" in
  start) start_shell ;;
  stop)  stop_shell ;;
  restart) stop_shell; sleep 1; start_shell ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "واجهة Windows 10-like: نشطة (PID: $(cat "$PIDFILE"))"
    else
      echo "واجهة Windows 10-like: غير نشطة"
    fi
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0