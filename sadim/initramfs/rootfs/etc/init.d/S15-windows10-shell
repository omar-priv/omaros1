#!/bin/sh
# Deprecated: the former taskbar/start-menu programs are terminal prototypes,
# not Wayland clients. Do not launch them in the background and call them a GUI.
case "$1" in
  start) echo "[desktop] legacy terminal mock disabled; Weston desktop shell is used" ;;
  stop|restart|status) echo "[desktop] no legacy GUI process is running" ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
