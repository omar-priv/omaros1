#!/bin/sh
# Initialize kernel built-in zRAM; never disable other swap devices.
set -u
ZRAM_DEV=/dev/zram0
ZRAM_SIZE_BYTES=268435456
start_zram() {
  echo "[zram] initializing 256 MiB RAM-backed swap"
  [ -b "$ZRAM_DEV" ] || { echo "[zram] ERROR: $ZRAM_DEV absent; CONFIG_ZRAM must be built in"; return 1; }
  [ -w /sys/block/zram0/disksize ] || { echo "[zram] ERROR: disksize sysfs node unavailable"; return 1; }
  echo 1 > /sys/block/zram0/reset 2>/dev/null || true
  echo "$ZRAM_SIZE_BYTES" > /sys/block/zram0/disksize || return 1
  command -v mkswap >/dev/null 2>&1 || { echo "[zram] ERROR: mkswap missing"; return 1; }
  command -v swapon >/dev/null 2>&1 || { echo "[zram] ERROR: swapon missing"; return 1; }
  mkswap "$ZRAM_DEV" >/dev/null || return 1
  swapon "$ZRAM_DEV" || return 1
  if grep -q "^$ZRAM_DEV " /proc/swaps; then echo "[zram] active: 256 MiB"; return 0; fi
  echo "[zram] ERROR: swapon did not register the device"
  return 1
}
stop_zram() {
  swapoff "$ZRAM_DEV" 2>/dev/null || true
  echo 1 > /sys/block/zram0/reset 2>/dev/null || true
}
case "$1" in
  start) start_zram ;;
  stop) stop_zram ;;
  restart) stop_zram; start_zram ;;
  status) grep -E '^Filename|zram' /proc/swaps 2>/dev/null || echo "zRAM inactive" ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
