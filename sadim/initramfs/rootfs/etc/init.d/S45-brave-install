#!/bin/sh
# Sadim OS — تثبيت متصفح Brave Browser تلقائياً عند الإقلاع الأول
# يتم تحميل Brave من موقعه الرسمي وتثبيته في /opt/brave
# لا أدوات خارجية — فقط wget و unzip المتوفرة في النظام

set -u

log() { echo "[brave] $*"; }

BRAVE_DIR="/opt/brave"
BRAVE_BIN="$BRAVE_DIR/brave-browser"
BRAVE_INSTALLED_FLAG="/var/lib/brave-installed"
BRAVE_URL="https://github.com/brave/brave-browser/releases/latest/download/brave-browser-linux-x64.zip"
BRAVE_EXPECTED_SHA256=""
BRAVE_SIGNATURE_URL="https://github.com/brave/brave-browser/releases/latest/download/brave-browser-linux-x64.zip.sig"

install_brave() {
  log "بدء تحميل وتثبيت متصفح Brave Browser…"

  if ! command -v wget >/dev/null 2>&1; then
    log "ERROR: wget غير مثبت — لا يمكن تحميل Brave Browser"
    return 1
  fi

  if ! command -v unzip >/dev/null 2>&1; then
    log "ERROR: unzip غير مثبت — لا يمكن استخراج Brave Browser"
    log "يمكن تثبيت unzip عبر Buildroot أو تنزيل Brave يدوياً من: https://brave.com/"
    return 1
  fi

  mkdir -p "$BRAVE_DIR"
  mkdir -p /var/lib

  if [ -f "$BRAVE_INSTALLED_FLAG" ] && [ -x "$BRAVE_BIN" ]; then
    log "Brave Browser مثبت مسبقاً — تخطي التثبيت"
    return 0
  fi

  log "تحميل Brave Browser من: $BRAVE_URL"
  if ! wget -q -O /tmp/brave-browser.zip "$BRAVE_URL" 2>/dev/null; then
    log "ERROR: تعذر تحميل Brave Browser — تحقق من اتصال الإنترنت"
    log "يمكن تثبيته يدوياً لاحقاً من: https://brave.com/"
    return 1
  fi

  if [ -n "$BRAVE_EXPECTED_SHA256" ] && command -v sha256sum >/dev/null 2>&1; then
    log "التحقق من تجزئة الملف المحمل…"
    ACTUAL_SHA256=$(sha256sum /tmp/brave-browser.zip 2>/dev/null | awk '{print $1}')
    if [ "$ACTUAL_SHA256" != "$BRAVE_EXPECTED_SHA256" ]; then
      log "ERROR: تجزئة الملف لا تتطابق!"
      log "  المتوقعة: $BRAVE_EXPECTED_SHA256"
      log "  الفعلية:   $ACTUAL_SHA256"
      log "  قد يكون الملف مخرباً أو مخترقاً — إيقاف التثبيت للأمان"
      rm -f /tmp/brave-browser.zip
      return 1
    fi
    log "تم التحقق من التجزئة بنجاح"
  elif [ -z "$BRAVE_EXPECTED_SHA256" ]; then
    log "WARN: تجزئة Brave غير محددة — التثبيت بدون التحقق من السلامة (غير موصى به للإنتاج)"
  fi

  log "تم تحميل Brave Browser — جاري الاستخراج…"

  if ! unzip -o /tmp/brave-browser.zip -d "$BRAVE_DIR" 2>/dev/null; then
    log "ERROR: تعذر استخراج ملف Brave Browser"
    rm -f /tmp/brave-browser.zip
    return 1
  fi

  chmod +x "$BRAVE_BIN" 2>/dev/null || true
  rm -f /tmp/brave-browser.zip
  touch "$BRAVE_INSTALLED_FLAG"

  log "تم تثبيت متصفح Brave Browser بنجاح في: $BRAVE_DIR"
  log "يمكن تشغيله عبر الأمر: $BRAVE_BIN"
}

start_brave() {
  install_brave
}

stop_brave() {
  log "متصفح Brave لا يحتاج إيقاف (تثبيت واحد)"
}

case "$1" in
  start) start_brave ;;
  stop)  stop_brave ;;
  restart) stop_brave; sleep 1; start_brave ;;
  status)
    if [ -f "$BRAVE_INSTALLED_FLAG" ] && [ -x "$BRAVE_BIN" ]; then
      echo "Brave Browser: مثبت في $BRAVE_DIR"
    else
      echo "Brave Browser: غير مثبت"
    fi
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
