#!/bin/sh
# Brave auto-install is disabled: the previous installer downloaded "latest"
# with an empty SHA256, so package integrity could not be checked.
case "$1" in
  start) echo "[browser] auto-download disabled until a pinned, verified package exists" ;;
  stop|restart|status) echo "[browser] no browser installer is active" ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
