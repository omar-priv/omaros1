#!/bin/sh
# Weston is intentionally started by S75-weston, after Buildroot's S70seatd.
case "$1" in
  start) echo "[weston] startup deferred to S75-weston (after seatd)" ;;
  stop|restart|status) echo "[weston] active service: /etc/init.d/S75-weston" ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
