#!/bin/sh
# Sadim OS — وضع بوابة CI: على الجذر المدمج بعد اكتمال كل الخدمات
set -u

case "$1" in
  start)
    if grep -qs "SADIM_CI=1" /proc/cmdline; then
      echo "[ci] services complete — clean reboot"
      sync
      sleep 1
      reboot -f
    fi
    exit 0
    ;;
  stop) exit 0 ;;
  *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
exit 0
