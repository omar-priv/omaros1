#!/bin/sh
# DHCP for the first detected wired interface, after eudev has populated devices.
set -u

find_wired_device() {
  for path in /sys/class/net/*; do
    [ -e "$path" ] || continue
    name=$(basename "$path")
    [ "$name" = "lo" ] && continue
    [ -d "$path/wireless" ] && continue
    printf '%s\n' "$name"
    return 0
  done
  return 1
}

start_network() {
  [ -r /proc/net/dev ] || { echo "[net] /proc/net/dev unavailable"; return 0; }
  DEV=""
  attempt=0
  while [ "$attempt" -lt 15 ]; do
    DEV=$(find_wired_device || true)
    [ -n "$DEV" ] && break
    attempt=$((attempt + 1))
    sleep 1
  done
  if [ -z "$DEV" ]; then
    echo "[net] no wired interface detected after udev settle"
    return 0
  fi
  command -v udhcpc >/dev/null 2>&1 || { echo "[net] udhcpc missing"; return 1; }
  ip link set "$DEV" up 2>/dev/null || {
    echo "[net] unable to bring $DEV up"
    return 1
  }
  echo "[net] requesting DHCP on $DEV"
  if udhcpc -i "$DEV" -s /etc/udhcpc.script -q -n -t 4 -T 3 > /var/log/udhcpc.log 2>&1; then
    ip addr show "$DEV" 2>/dev/null || ifconfig "$DEV" 2>/dev/null || true
    echo "SADIM-NET-OK"
  else
    echo "[net] no DHCP lease on $DEV"
    tail -n 8 /var/log/udhcpc.log 2>/dev/null || true
  fi
}
case "$1" in
  start) start_network ;;
  stop) echo "[net] DHCP client is not kept as a service" ;;
  restart) start_network ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
