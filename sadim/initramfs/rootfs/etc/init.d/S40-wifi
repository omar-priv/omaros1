#!/bin/sh
# Bring up a discovered wireless interface. Do not claim association without
# a user-provided network configuration and a real WPA connection.
set -u
IFACE=""
for candidate in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^(wlan|wlp)' || true); do
  IFACE="$candidate"
  break
done
case "$1" in
  start)
    if [ -z "$IFACE" ]; then
      echo "[wifi] no wireless interface detected"
      exit 0
    fi
    echo "[wifi] detected interface: $IFACE"
    ip link set "$IFACE" up 2>/dev/null || {
      echo "[wifi] ERROR: could not bring $IFACE up"
      exit 1
    }
    WPA_CONFIG=/etc/wpa_supplicant.conf
    WPA_BIN=$(command -v wpa_supplicant 2>/dev/null || true)
    if [ -n "$WPA_BIN" ] && [ -s "$WPA_CONFIG" ]; then
      mkdir -p /run/wpa_supplicant
      "$WPA_BIN" -B -i "$IFACE" -c "$WPA_CONFIG" -C /run/wpa_supplicant || {
        echo "[wifi] ERROR: wpa_supplicant failed"
        exit 1
      }
      echo "[wifi] WPA configured; DHCP requested"
      udhcpc -i "$IFACE" -s /etc/udhcpc.script -q -n -t 4 -T 3 >/var/log/wifi-dhcp.log 2>&1 &
    else
      echo "[wifi] interface is up; no saved Wi-Fi credentials configured"
    fi
    ;;
  stop)
    killall wpa_supplicant 2>/dev/null || true
    [ -z "$IFACE" ] || ip link set "$IFACE" down 2>/dev/null || true
    ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status)
    [ -z "$IFACE" ] && { echo "No wireless interface"; exit 1; }
    ip link show "$IFACE"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
