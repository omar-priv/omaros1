#!/bin/sh
# Sound status only. HDA drivers are built into the kernel configuration.
set -u
case "$1" in
  start)
    if [ -d /proc/asound ]; then
      found=0
      for card in /proc/asound/card*/id; do
        [ -r "$card" ] || continue
        echo "[sound] detected card: $(cat "$card")"
        found=1
      done
      [ "$found" -eq 1 ] || echo "[sound] no sound card detected"
    else
      echo "[sound] ALSA proc interface not available"
    fi
    ;;
  stop|restart) echo "[sound] built-in kernel driver; no module action" ;;
  status) cat /proc/asound/cards 2>/dev/null || echo "No ALSA cards detected" ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
