#!/bin/sh
# Lightweight, read-only metrics. Do not call drop_caches when RAM use is high.
set -u
LOG_FILE=/var/log/sadim-monitor.log
INTERVAL="${SADIM_MONITOR_INTERVAL:-300}"
case "$INTERVAL" in
  ''|*[!0-9]*) INTERVAL=300 ;;
esac
[ "$INTERVAL" -gt 0 ] 2>/dev/null || INTERVAL=300
PID_FILE=/var/run/sadim-monitor.pid
collect_metrics() {
  ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date)
  mem_total=0
  mem_avail=0
  mem_pct=N/A
  if [ -r /proc/meminfo ]; then
    mem_total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    mem_avail=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    if [ -n "$mem_total" ] && [ "$mem_total" -gt 0 ] 2>/dev/null; then
      mem_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))
    fi
  fi
  load1=N/A
  [ -r /proc/loadavg ] && read -r load1 _ < /proc/loadavg
  temp=N/A
  for f in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$f" ] || continue
    raw=$(cat "$f" 2>/dev/null || echo "")
    case "$raw" in *[!0-9]*|"") continue ;; esac
    temp="$((raw / 1000))C"
    break
  done
  io_rd=N/A
  io_wr=N/A
  if [ -r /proc/diskstats ]; then
    io_rd=$(awk '$3 ~ /^(sda|sdb|nvme[0-9]+n[0-9]+)$/ {v+=$6} END {print v+0}' /proc/diskstats)
    io_wr=$(awk '$3 ~ /^(sda|sdb|nvme[0-9]+n[0-9]+)$/ {v+=$10} END {print v+0}' /proc/diskstats)
  fi
  printf '%s | RAM_used=%s%% | load1=%s | temp=%s | sectors_read=%s | sectors_written=%s\n' "$ts" "$mem_pct" "$load1" "$temp" "$io_rd" "$io_wr" >> "$LOG_FILE" 2>/dev/null || true
  [ "$mem_pct" = N/A ] || [ "$mem_pct" -le 90 ] 2>/dev/null || echo "$ts | WARNING: high memory pressure ($mem_pct%)" >> "$LOG_FILE"
}
start_monitor() {
  mkdir -p /var/log /var/run
  touch "$LOG_FILE"
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null && return 0
  (while :; do collect_metrics; sleep "$INTERVAL" || sleep 300; done) &
  echo $! > "$PID_FILE"
  echo "[monitor] started; interval=$INTERVAL s"
}
stop_monitor() {
  [ -f "$PID_FILE" ] || return 0
  kill "$(cat "$PID_FILE")" 2>/dev/null || true
  rm -f "$PID_FILE"
}
case "$1" in
  start) start_monitor ;;
  stop) stop_monitor ;;
  restart) stop_monitor; start_monitor ;;
  status) [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null && echo "monitor active" || echo "monitor inactive" ;;
  metrics) collect_metrics ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
