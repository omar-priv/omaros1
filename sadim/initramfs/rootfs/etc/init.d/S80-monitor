#!/bin/sh
# Sadim OS — مراقبة تلقائية للأداء والموارد (مرحلة 7)
# تراقب: RAM، CPU، IO، درجة الحرارة، مساحة القرص
# تسجل في /var/log/sadim-monitor.log كل 5 دقائق
# مصممة لتكون خفيفة جداً (لا تضغط على موارد 4GB RAM)
set -u

LOG_FILE="/var/log/sadim-monitor.log"
INTERVAL="${SADIM_MONITOR_INTERVAL:-300}"  # 5 دقائق افتراضياً
PID_FILE="/var/run/sadim-monitor.pid"

log() { echo "[monitor] $*"; }

collect_metrics() {
  local ts
  ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

  # ذاكرة RAM
  local mem_total mem_free mem_avail mem_used mem_pct
  if [ -r /proc/meminfo ]; then
    mem_total=$(grep '^MemTotal:' /proc/meminfo | awk '{print $2}')
    mem_free=$(grep '^MemFree:' /proc/meminfo | awk '{print $2}')
    mem_avail=$(grep '^MemAvailable:' /proc/meminfo | awk '{print $2}')
    if [ -n "$mem_total" ] && [ -n "$mem_avail" ]; then
      mem_used=$((mem_total - mem_avail))
      mem_pct=$(( mem_used * 100 / mem_total ))
    else
      mem_pct="N/A"
    fi
  else
    mem_pct="N/A"
  fi

  # تحميل CPU (أ minuto)
  local load1 load5 load15
  if [ -r /proc/loadavg ]; then
    read -r load1 load5 load15 _ < /proc/loadavg
  else
    load1="N/A"
  fi

  # درجة الحرارة (إن وجدت)
  local temp="N/A"
  if [ -r /sys/class/thermal/thermal_zone0/temp ]; then
    temp=$(( $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0) / 1000 ))
  fi

  # IO على الهارد (읽/كتابة قطاعات)
  local io_rd io_wr
  if [ -r /proc/diskstats ]; then
    io_rd=$(awk '/sda|nvme/ {rd+=$6} END {print rd+0}' /proc/diskstats 2>/dev/null)
    io_wr=$(awk '/sda|nvme/ {wr+=$10} END {print wr+0}' /proc/diskstats 2>/dev/null)
  fi

  # مساحة القرص المتاحة
  local disk_avail disk_pct
  if [ -x /bin/df ]; then
    disk_avail=$(df / 2>/dev/null | awk 'NR==2 {print $4}')
    disk_pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
  fi

  # حالة zRAM swap
  local swap_status="none"
  if [ -b /dev/zram0 ]; then
    swap_status=$(swapon --show 2>/dev/null | grep zram | awk '{print $4}' 2>/dev/null || echo "active")
  fi

  # كتابة السجل
  {
    echo "$ts | RAM: ${mem_pct}% | CPU_load: ${load1} | Temp: ${temp}C | Disk_avail: ${disk_avail}KB | Disk_use: ${disk_pct}% | IO_rd: ${io_rd} | IO_wr: ${io_wr} | Swap: ${swap_status}"
  } >> "$LOG_FILE" 2>/dev/null

  # تنبيه إذا كانت الذاكرة مرتفعة جداً (أكثر من 85%)
  if [ "$mem_pct" != "N/A" ] && [ "$mem_pct" -gt 85 ] 2>/dev/null; then
    echo "$ts | WARNING: استهلاك الذاكرة مرتفع ${mem_pct}% — جاري تفريغ ذاكرة zRAM" >> "$LOG_FILE" 2>/dev/null
    sync 2>/dev/null
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
  fi
}

start_monitor() {
  mkdir -p /var/log
  touch "$LOG_FILE"
  log "بدء المراقبة التلقائية (الفاصل: ${INTERVAL ثانية)…"

  # تشغيل المراقبة في الخلفية (حلقة)
  (
    while :; do
      collect_metrics
      sleep "$INTERVAL"
    done
  ) &
  echo $! > "$PID_FILE"
  log "تم تشغيل المراقب (PID: $(cat "$PID_FILE"))"
}

stop_monitor() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
    log "تم إيقاف المراقب"
  fi
}

status_monitor() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "المراقب نشط (PID: $(cat "$PID_FILE"))"
  else
    echo "المراقب غير نشط"
  fi
  echo "آخر السجلات:"
  tail -n 5 "$LOG_FILE" 2>/dev/null || echo "(لا سجلات بعد)"
}

case "$1" in
  start) start_monitor ;;
  stop)  stop_monitor ;;
  restart) stop_monitor; sleep 1; start_monitor ;;
  status) status_monitor ;;
  metrics) collect_metrics ;;
  *) echo "Usage: $0 {start|stop|restart|status|metrics}"; exit 1 ;;
esac
exit 0
