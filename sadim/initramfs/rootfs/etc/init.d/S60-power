#!/bin/sh
# Read ACPI power/thermal information without attempting to modprobe built-ins.
set -u
show_power() {
  found=0
  for bat in /sys/class/power_supply/BAT*; do
    [ -d "$bat" ] || continue
    found=1
    name=$(basename "$bat")
    capacity=$(cat "$bat/capacity" 2>/dev/null || echo "N/A")
    status=$(cat "$bat/status" 2>/dev/null || echo "N/A")
    echo "[power] $name: $capacity% ($status)"
  done
  [ "$found" -eq 1 ] || echo "[power] no battery device exposed by firmware/kernel"
  for zone in /sys/class/thermal/thermal_zone*; do
    [ -r "$zone/temp" ] || continue
    raw=$(cat "$zone/temp" 2>/dev/null || echo "")
    case "$raw" in *[!0-9]*|"") continue ;; esac
    echo "[power] $(basename "$zone"): $((raw / 1000)) C"
  done
}
case "$1" in
  start|status) show_power ;;
  stop|restart) echo "[power] read-only status service; nothing to stop" ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
