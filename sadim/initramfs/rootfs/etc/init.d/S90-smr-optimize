#!/bin/sh
# Live-mode safety: never identify /dev/sda as an internal HDD or alter its
# write-cache settings. The Live root is read-only SquashFS plus tmpfs overlay.
case "$1" in
  start)
    echo "[storage] Live root is SquashFS + tmpfs overlay"
    echo "[storage] no internal disk is mounted or modified automatically"
    mount | grep ' on / ' || true
    ;;
  stop|restart) echo "[storage] read-only safety status; no disk tuning applied" ;;
  status)
    echo "=== block devices (information only) ==="
    cat /proc/partitions 2>/dev/null || true
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
